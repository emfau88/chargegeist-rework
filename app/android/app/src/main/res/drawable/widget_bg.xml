<?xml version="1.0" encoding="utf-8"?>
<!-- The widget's ground: the night of the app, a little lighter at the top, with a fine line round it. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="270"
        android:endColor="#14112A"
        android:startColor="#2B2366" />
    <corners android:radius="@dimen/widget_radius" />
    <stroke
        android:width="1dp"
        android:color="#3DBEB4FF" />
</shape>
